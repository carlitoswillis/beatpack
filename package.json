{
  "name": "beatpack",
  "version": "1.0.0",
  "description": "zip, convert to mp3, create a video, and upload to YouTube",
  "main": "main.js",
  "scripts": {
    "build:dev": "webpack --watch",
    "test": "jest",
    "test:dev": "jest --watchAll",
    "cli": "node index.js",
    "start": "electron .",
    "package-mac": "electron-packager . --overwrite --platform=darwin --arch=arm64 --icon=assets/icons/mac/icon.icns --prune=true --out=release-builds",
    "package-win": "electron-packager . beatpack --overwrite --asar=true --platform=win32 --arch=x64 --icon=assets/icons/win/icon.ico --prune=true --out=release-builds --win32metadata.CompanyName=CE --win32metadata.FileDescription=CE --win32metadata.ProductName=BeatPack",
    "package-linux": "electron-packager . beatpack --overwrite --asar=true --platform=linux --arch=x64 --icon=assets/icons/png/icon.png --prune=true --out=release-builds",
    "build": "webpack --mode production"
  },
  "author": "Carlitos Willis",
  "license": "ISC",
  "dependencies": {
    "archiver": "^6.0.2",
    "csv-write-stream": "^2.0.0",
    "ejs": "^3.1.10",
    "express": "^4.17.1",
    "gm": "^1.25.1",
    "google-auth-library": "^6.0.6",
    "googleapis": "^58.0.0",
    "image-size": "^2.0.2",
    "jquery": "^3.5.1",
    "jsonwebtoken": "^8.5.1",
    "multer": "^1.4.2",
    "react": "^18.3.1",
    "react-datepicker": "^4.25.0",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@babel/core": "^7.10.5",
    "@babel/preset-env": "^7.10.4",
    "@babel/preset-react": "^7.10.4",
    "@electron/packager": "^20.3.0",
    "babel-loader": "^10.1.1",
    "css-loader": "^7.1.5",
    "electron": "^44.2.0",
    "eslint": "^8.57.1",
    "eslint-config-airbnb": "^19.0.4",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^4.6.2",
    "jest": "^30.5.1",
    "style-loader": "^4.0.0",
    "svg-inline-loader": "^0.8.2",
    "webpack": "^5.110.3",
    "webpack-cli": "^7.2.3"
  }
}
